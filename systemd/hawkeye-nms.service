[Unit]
Description=Hawkeye - Node-Media-Server (RTMP :1935, http-flv :8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Node-Media-Server
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node bin/app.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
