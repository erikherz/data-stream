[Unit]
Description=Hawkeye - SRT -> HLS rebroadcast receiver (view-only station)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hawkeye-data-stream
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# SRT_PORT is the inbound UDP listener the origin pushes to. Override via a
# drop-in if you pull (caller mode) instead: Environment=SRT_URL=srt://host:port?mode=caller
Environment=SRT_PORT=9000
ExecStartPre=/usr/bin/bash -c 'mkdir -p /var/www/html/hls && rm -f /var/www/html/hls/*'
ExecStart=/usr/bin/node bin/srt-receive.js /var/www/html/hls receiver
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
